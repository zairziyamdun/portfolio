{
	"useTabs": true,
	"tabWidth": 2,
	"semi": false,
	"singleQuote": true,
	"jsxSingleQuote": false,
	"trailingComma": "none",
	"printWidth": 80,
	"arrowParens": "avoid",
	"bracketSameLine": false,
	"singleAttributePerLine": true,
	"endOfLine": "lf",
	"plugins": ["prettier-plugin-tailwindcss"],
	"tailwindStylesheet": "./src/app/styles/globals.css",
	"tailwindFunctions": ["cn", "cva"]
}
